{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "AllowedOrigins": [
      "https://app.pesaroll.co.ke"
    ]
  },
  "Auth": {
    "SecureCookie": true,
    "RateLimitPerMinute": 10,
